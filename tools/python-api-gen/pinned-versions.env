# Pinned version and checkout path for the Python thin-client API
# documentation generator.
#
# The Makefile `include`s this file as Make syntax. All variables use
# `?=`, so environment variables and `make VAR=value` overrides take
# precedence over the defaults below; this lets the generator run
# unchanged on a workstation whose checkout lives elsewhere by setting
# the relevant variable in the shell.
#
# Unlike thin-client-api-gen, this generator does not require the
# checkout to be *on* the pinned tag: it exports the tag with
# `git archive`, so your working tree is left untouched on whatever
# branch it happens to occupy.

THINCLIENT_TAG  ?= 0.0.22

THINCLIENT_PATH ?= /home/human/thin_client
